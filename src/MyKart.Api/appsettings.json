{
  "ConnectionStrings": {
    "MyKart": "Server=(localdb)\\MSSQLLocalDB;Database=MyKartWebhooks;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Stripe": {
    "WebhookSecret": "your_stripe_webhook_secret_here"
  },
  "Webhooks": {
    "DisableEndpointAfter": "3.00:00:00",
    "DispatchBatchSize": 20,
    "AllowPrivateNetworks": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
